# ---------------------------------------------------------------------------
# SMART TRAFFIC — environment configuration
# Copy to .env and replace every "change-me" value before running.
# Hostnames (postgres, redis, ai-service) are docker-compose service names;
# when running the backend directly on the host use localhost instead.
# ---------------------------------------------------------------------------

# Core
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
DEMO_MODE=true
ENABLE_DOCS=true
DISPLAY_TIMEZONE=Asia/Tashkent
HTTP_PORT=80

# PostgreSQL
POSTGRES_USER=smart
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=smart_traffic
DATABASE_URL=postgresql+asyncpg://smart:change-me-postgres@postgres:5432/smart_traffic
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Seed (scripts/seed_database.py). Leave empty in development to get a generated password printed once.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Authentication (generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=change-me-generate-a-long-random-secret-at-least-32-chars
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
# Fernet key for camera credentials: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMERA_SECRET_KEY=change-me-fernet-key
STREAM_TOKEN_SECRET=change-me-generate-a-long-random-secret-at-least-32-chars

# AI service
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TOKEN=change-me-generate-a-long-random-secret-at-least-32-chars
AI_MODE=mock
AI_DETECTOR=onnx
BACKEND_URL=http://backend:8000
HEARTBEAT_INTERVAL_SECONDS=5
HEARTBEAT_TIMEOUT_SECONDS=30

# Evidence storage (local | s3)
STORAGE_BACKEND=local
STORAGE_PATH=/data/storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=smart-traffic-evidence
S3_ACCESS_KEY=
S3_SECRET_KEY=

# HTTP
CORS_ORIGINS=http://localhost:5173,http://localhost
WEBSOCKET_URL=ws://localhost/api/v1/ws

# Mail (forgot password); leave SMTP_HOST empty to log emails to the console in development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@smart-traffic.uz

# Frontend (Vite, build-time)
VITE_API_URL=/api/v1
VITE_WS_URL=/api/v1/ws
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
