# All variables are optional; defaults are shown.
# API base path (nginx / Vite proxy forward /api to the backend).
VITE_API_BASE_URL=/api/v1
# IANA time zone used to display timestamps.
VITE_DISPLAY_TIMEZONE=Asia/Tashkent
# Map tiles; empty means public OpenStreetMap tiles.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
